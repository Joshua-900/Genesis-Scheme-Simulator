graph TB
    %% ===== BACKEND =====
    BACKEND["backend.py<br/><i>xp = NumPy or CuPy</i><br/><i>to_cpu() for rendering</i>"]

    %% ===== STATE =====
    subgraph STATE["GenesisState  (core.py)"]
        direction LR
        S_THETA["theta (N x N)<br/><b>THE single DOF</b><br/><i>orientation 0 to 2pi</i>"]
        S_TAU["tau (N x N)<br/><i>tension field<br/>(accumulated disagreement)</i>"]
        S_GEOM["ux, uy (N x N)<br/><i>displacement field<br/>(protospace deformation)</i>"]
        S_C["C (N x N)<br/><i>compression field<br/>(fold intensity 0 to 1)</i>"]
        S_GRID["X, Y (N x N)<br/><i>base grid coordinates</i>"]
    end

    %% ===== PARAMS =====
    subgraph PARAMS["GenesisParams  (core.py)"]
        direction TB
        subgraph P_CORE["Core Physics"]
            P_ALPHA["alpha  <i>alignment coupling</i>"]
            P_GAMMA["gamma  <i>tension gain</i>"]
            P_KAPPA["kappa  <i>geometry coupling</i>"]
            P_CURV["curv  <i>curvature feedback</i>"]
        end
        subgraph P_OPTIONAL["Optional Forces"]
            P_PHASE["phase  <i>4-well strength</i>"]
            P_DIPOLE["dipole  <i>head-tail coupling</i>"]
            P_TRIADS["triads  <i>3-body cohesion</i>"]
        end
        subgraph P_LOCKING["Locking Mechanics"]
            P_LOCK["lock_strength  <i>freeze intensity</i>"]
            P_PLOCK["phase_lock_gain  <i>amplify phase in folds</i>"]
            P_TLOCK["tri_lock_gain  <i>amplify triads in folds</i>"]
            P_SHELL["shell_geom_gain  <i>compression gradient push</i>"]
        end
        subgraph P_HOUSE["Housekeeping"]
            P_DECAY["decay_tau, geom_decay"]
            P_SIGMA["sigma_c2, tri_sigma2"]
        end
    end

    %% ===== STEP FUNCTION =====
    subgraph STEP["step(state, params, rules, post)  (core.py)"]
        direction TB

        INIT_TORQUE["torque_total = zeros(N, N)<br/>extra = {}"]

        subgraph PIPELINE["Rule Pipeline  (pluggable, ordered)"]
            direction TB

            subgraph R1["rules_alignment.py"]
                R1_IN["Reads: state.theta"]
                R1_DO["sin(theta_neighbor - theta)<br/>for 4 cardinal neighbors"]
                R1_OUT["Returns: alpha * dtheta_align<br/>Shares: dtheta_align, grad_align"]
                R1_IN --> R1_DO --> R1_OUT
            end

            subgraph R2["rules_compression.py"]
                R2_IN["Reads: state.theta, ux, uy, tau<br/>Uses: grad_align from extra"]
                R2_DO["1. tau += gamma * grad  (tension)<br/>2. ux,uy += kappa * tau * dir  (geometry)<br/>3. detF = det(deformation gradient)<br/>4. C = exp(-detF^2 / sigma)  (compression)<br/>5. Shell push: ux,uy += gain * grad(C)"]
                R2_OUT["Returns: 0.1 * tau<br/>Shares: detF, C<br/>Mutates: state.tau, ux, uy, C"]
                R2_IN --> R2_DO --> R2_OUT
            end

            subgraph R3["rules_curvature.py"]
                R3_IN["Reads: state.ux, uy, theta"]
                R3_DO["Laplacian of (ux, uy)<br/>curv_mag, phi_curv = direction<br/>torque toward curvature direction"]
                R3_OUT["Returns: curv * mag * sin(phi - theta)"]
                R3_IN --> R3_DO --> R3_OUT
            end

            subgraph R4["rules_phase.py  (optional)"]
                R4_DO["-phase * sin(4 * theta)<br/>4-well potential"]
                R4_OUT["Returns: phase_force<br/>Shares: phase_torque"]
                R4_DO --> R4_OUT
            end

            subgraph R5["rules_dipoles.py  (optional)"]
                R5_DO["Head-tail interaction<br/>on deformed grid (X+ux, Y+uy)<br/>Vectorized with np.roll"]
                R5_OUT["Returns: dipole * torque"]
                R5_DO --> R5_OUT
            end

            subgraph R6["rules_triads.py  (optional)"]
                R6_DO["3-body L-shape templates<br/>Gaussian match score<br/>Vectorized with np.roll"]
                R6_OUT["Returns: triad torque<br/>Shares: tri_torque"]
                R6_DO --> R6_OUT
            end

            subgraph R6B["rules_triads_relative.py  (optional)"]
                R6B_DO["Rotationally invariant triads<br/>Angle DIFFERENCES only<br/>No absolute targets"]
                R6B_OUT["Returns: triad torque<br/>Shares: tri_torque"]
                R6B_DO --> R6B_OUT
            end

            subgraph R7["relax.py  (optional)"]
                R7_DO["Softened tension/geometry<br/>in compressed zones<br/>Angular diffusion"]
                R7_OUT["Returns: diffusion torque<br/>Mutates: state.tau, ux, uy"]
                R7_DO --> R7_OUT
            end
        end

        SUM["torque_total += each rule's torque"]

        subgraph POST["rules_locking.py  (post-processor)"]
            POST_AMP["Amplify phase/triad torques<br/>in compressed cores:<br/>torque += gain * C * component"]
            POST_FREEZE["Freeze in compressed regions:<br/>torque *= (1 - lock * C)"]
            POST_AMP --> POST_FREEZE
        end

        THETA_UP["state.theta = (theta + dt * torque) % 2pi"]

        INIT_TORQUE --> PIPELINE
        PIPELINE --> SUM
        SUM --> POST
        POST --> THETA_UP
    end

    %% ===== DIAGNOSTICS =====
    subgraph DIAG["diagnostics.py  (read-only, never in pipeline)"]
        D_VORTEX["detect_vortices()<br/><i>Winding number on plaquettes<br/>Returns +1/-1 positions</i>"]
        D_UNITY["compute_unity()<br/><i>Local coherence magnitude<br/>Neighborhood order parameter</i>"]
    end

    %% ===== ADAPTER =====
    subgraph ADAPTER["adapter.py"]
        A_ENGINE["GenesisGridEngine<br/><i>Conforms to GenesisEngine Protocol</i>"]
        A_DEFAULT["DEFAULT_RULES = [<br/>  alignment, compression, relax,<br/>  phase, dipoles, triads, curvature<br/>]"]
        A_ENGINE --> A_DEFAULT
    end

    %% ===== UI VARIANTS =====
    subgraph UIS["UI Variants  (6 files)"]
        UI_MPL["ui_matplotlib  1, 2, 3<br/><i>Dashes, heatmaps, contours, sliders</i>"]
        UI_VISPY["ui_vispy  1, 2, 3<br/><i>GPU rendering via PyQt5 + VisPy</i>"]
    end

    %% ===== CONNECTIONS =====
    BACKEND -. "provides xp" .-> STATE
    BACKEND -. "provides xp" .-> PIPELINE

    PARAMS -- "read by every rule" --> PIPELINE
    PARAMS --> POST

    STATE -- "read & mutated by rules" --> PIPELINE
    STATE -- "read by post" --> POST
    THETA_UP -- "writes" --> S_THETA

    STATE -. "read only" .-> DIAG

    ADAPTER -- "calls step()" --> STEP
    UIS -- "calls step()" --> STEP
    UIS -. "reads state for rendering" .-> STATE

    %% ===== STYLING =====
    classDef state fill:#f0fdfa,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef params fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a5f
    classDef step fill:#faf5ff,stroke:#7c3aed,stroke-width:2px,color:#3b0764
    classDef rules fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    classDef optional fill:#fefce8,stroke:#ca8a04,stroke-width:1px,color:#713f12
    classDef post fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d
    classDef diag fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#475569
    classDef adapter fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#14532d
    classDef backend fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#475569

    class STATE state
    class PARAMS,P_CORE,P_LOCKING,P_HOUSE,P_OPTIONAL params
    class STEP step
    class PIPELINE,R1,R2,R3 rules
    class R4,R5,R6,R6B,R7 optional
    class POST post
    class DIAG diag
    class ADAPTER adapter
    class BACKEND backend
    class UIS adapter
